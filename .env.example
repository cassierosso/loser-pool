# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset (or use a pglite:// URL) to run against an embedded
# PGlite database at ./.pglite -- no server required. Point it at Postgres
# (Neon, docker compose, anything) and every driver-specific path switches over.
#
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/loser_survivor
#   DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL=pglite://./.pglite

# The migration/owner connection. Phase 6 (SS7.3) creates a restricted
# application role that holds INSERT/SELECT on audit_log but not UPDATE/DELETE;
# migrations must run as the owner, the app as the restricted role. Kept as a
# separate variable from the start so that change is not a plumbing retrofit.
DATABASE_URL_MIGRATOR=pglite://./.pglite

# ---------------------------------------------------------------------------
# Jobs (Phase 3+)
# ---------------------------------------------------------------------------
CRON_SECRET=
