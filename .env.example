# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Run `npm run db:serve` for a local Postgres with nothing to install: it hosts
# an embedded PGlite database over the real Postgres wire protocol. Any
# username and password are accepted.
#
# Do NOT point the app at a pglite:// path directly. PGlite is a single-process
# database, and the dev server opens it more than once (hot reload, plus
# separate bundles for server components and route handlers), which aborts the
# WASM instance. The socket server exists precisely to avoid that.
#
# Swap in Neon or any other Postgres by changing this one line:
#   DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# The migration/owner connection. Phase 6 (SS7.3) creates a restricted
# application role that holds INSERT/SELECT on audit_log but not UPDATE/DELETE;
# migrations must run as the owner, the app as the restricted role. Kept as a
# separate variable from the start so that change is not a plumbing retrofit.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Jobs (Phase 3+)
# ---------------------------------------------------------------------------
CRON_SECRET=
